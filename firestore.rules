rules_version = '2';

// Published from the Firebase console (Krambua Tilsette project) — kept
// here too so the rule that protects the data lives next to the code that
// depends on it. Every visitor signs in anonymously (see src/lib/firebase.ts)
// so this only blocks requests that never went through the app at all; it
// is not equivalent to per-employee authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
